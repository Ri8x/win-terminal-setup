{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",

    // ── Global behaviour ─────────────────────────────────────
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "copyFormatting": "none",
    "copyOnSelect": false,
    "trimBlockSelection": true,
    "initialCols": 130,
    "initialRows": 35,

    // ── Tab & title bar ──────────────────────────────────────
    "showTabsInTitlebar": true,
    "tabWidthMode": "titleLength",
    "alwaysShowTabs": true,
    "theme": "TokyoNight",

    // ── Keybindings ──────────────────────────────────────────
    "keybindings": [
        { "id": "Terminal.CopyToClipboard",     "keys": "ctrl+c"       },
        { "id": "Terminal.PasteFromClipboard",  "keys": "ctrl+v"       },
        { "id": "Terminal.FindText",            "keys": "ctrl+shift+f" },
        { "id": "Terminal.DuplicatePaneAuto",   "keys": "alt+shift+d"  },
        { "id": "Terminal.SplitPaneAuto",       "keys": "ctrl+shift+\\" },
        { "id": "Terminal.ClosePane",           "keys": "ctrl+shift+w" },
        { "id": "Terminal.NewTab",              "keys": "ctrl+t"       },
        { "id": "Terminal.CloseTab",            "keys": "ctrl+w"       },
        { "id": "Terminal.NextTab",             "keys": "ctrl+tab"     },
        { "id": "Terminal.PrevTab",             "keys": "ctrl+shift+tab" }
    ],

    // ── Profiles ─────────────────────────────────────────────
    "profiles": {
        "defaults": {
            // Font with full Nerd Font / symbol support
            "font": {
                "face": "JetBrainsMono Nerd Font",
                "size": 11,
                "weight": "normal"
            },

            // Translucent acrylic background
            "useAcrylic": true,
            "acrylicOpacity": 0.88,

            // Color & cursor
            "colorScheme": "Tokyo Night Storm",
            "cursorShape": "bar",
            "cursorColor": "#7aa2f7",

            // Padding & scrollback
            "padding": "12, 8",
            "scrollbarState": "hidden",
            "historySize": 30000,

            // Misc
            "antialiasingMode": "cleartype",
            "closeOnExit": "graceful",
            "bellStyle": "none"
        },

        "list": [
            // ── PowerShell 7  (default) ──────────────────────
            {
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "name": "PowerShell 7",
                "commandline": "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\pwsh.exe -NoLogo",
                "icon": "ms-appx:///ProfileIcons/{574e775e-4f2a-5b96-ac1e-a2962a402336}.scale-200.png",
                "hidden": false,
                "startingDirectory": "%USERPROFILE%"
            },

            // ── Windows PowerShell 5.1 ───────────────────────
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell",
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoLogo",
                "hidden": false,
                "startingDirectory": "%USERPROFILE%"
            },

            // ── Command Prompt ───────────────────────────────
            {
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "name": "Command Prompt",
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "hidden": false
            },

            // ── Azure Cloud Shell ────────────────────────────
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "hidden": true,
                "name": "Azure Cloud Shell",
                "source": "Windows.Terminal.Azure"
            }
        ]
    },

    // ── Color Schemes ────────────────────────────────────────
    "schemes": [
        {
            "name": "Tokyo Night Storm",

            // Basics
            "background":  "#24283b",
            "foreground":  "#c0caf5",
            "cursorColor": "#c0caf5",
            "selectionBackground": "#364a82",

            // Normal colors
            "black":         "#1d202f",
            "blue":          "#7aa2f7",
            "cyan":          "#7dcfff",
            "green":         "#9ece6a",
            "purple":        "#bb9af7",
            "red":           "#f7768e",
            "white":         "#a9b1d6",
            "yellow":        "#e0af68",

            // Bright colors
            "brightBlack":   "#414868",
            "brightBlue":    "#7aa2f7",
            "brightCyan":    "#7dcfff",
            "brightGreen":   "#9ece6a",
            "brightPurple":  "#bb9af7",
            "brightRed":     "#ff899d",
            "brightWhite":   "#c0caf5",
            "brightYellow":  "#ff9e64"
        }
    ],

    // ── Themes (custom tab bar colour) ───────────────────────
    "themes": [
        {
            "name": "TokyoNight",
            "tab": {
                "background": "#1f2335ff",
                "showCloseButton": "always",
                "unfocusedBackground": "#1a1b2eff"
            },
            "tabRow": {
                "background": "#1f2335ff",
                "unfocusedBackground": "#1a1b2eff"
            },
            "window": {
                "applicationTheme": "dark",
                "useMica": false
            }
        }
    ],

    "newTabMenu": [{ "type": "remainingProfiles" }],
    "actions": []
}
